package main

// 壁纸：一张静态插画，只有遮罩圈定的局部（甘雨是头部发丝）随时间摆动。
//
// 模型照搬参考项目（HanaBi-ui-Genshin 的 LayeredWallpaper），并且同样是**多层**：
// 每层一张区域遮罩，各自的空间频率、速度、相位、方向都不同；位移累加后，
// 相邻发缕的位移量不同，看起来就是一缕一缕分开飘，而不是整片一起晃。
//
//	mask  = masks.Sample(q)[j]
//	phase = 空间频率·q + 时间，经多阶正弦求和
//	q    += dir * 幅度 * phase * mask
//	return image.Sample(clamp, q)
//
// 三个要点，都是实测后定的：
//  1. **始终采样同一张图**（image0）。曾叠第二张人物图相对漂移，等于把另一张画
//     平移一段盖上去，相邻像素整体错位 → 观感是"两个人在相对移动"。已废弃。
//  2. **方向是常量**，不是从图里读。原项目 flow-rg 实测 95% 像素是中性色
//     (127,127)、只有约 5% 有方向，当逐像素方向场用只会零星几点在抖。
//     参考项目同样用每层配置的常量方向（b.xy），这里照做。
//  3. **分层靠遮罩本身**，不靠调参。三张遮罩覆盖的区域本来就不同，相乘累加
//     天然得到分层次效果——这是素材决定的，不是凭空调的。
//
// 素材语义（按像素实测）：
//   - flow-mask 960×540 灰度：整片发区，非零 9.51%，bbox x 31.5~81.6% / y 0~42%
//   - wave-a    1920×1080 灰度：局部一缕，非零 1.08%，bbox x 46.6~59.2% / y 26.5~42.7%
//   - wave-b    1920×1080 灰度：局部一缕，非零 1.57%，bbox x 50.3~59.7% / y 0~20.3%
//   - flow-phase 1920×1080 灰度：实测全 255，无信息量，不使用
//   - flow-rg    1920×1080 RGB：见上面第 2 点，不使用

var Time float // 秒，动效时钟
var Play float // 0..1，动效强度；0 = 完全静止（截图对比与低功耗场景用）

var Tint vec3        // 目标色调（元素色，0..1）
var TintAmount float // 0 = 原色，1 = 完全染色

// FlowStrength 是**基础层**的最大位移，单位是图片 UV（0.01 = 图宽的 1%）。
// 细缕层在此基础上乘 1.25~1.35——它们覆盖面积小，需要略大的位移才看得出来。
// 0 表示该主题没有流动素材，整段跳过，其余主题完全不受影响。
var FlowStrength float

// FlowDir 是形变主方向（单位向量，y 向下）。零向量按 (1, 0) 处理。
var FlowDir vec2

// wave 是三阶正弦的谐波求和。
//
// 纯正弦走起来像机械抖动；叠上高次谐波才有"快慢不一、不是匀速刷过去"的自然感。
// 系数取自参考项目 LayeredWallpaper 里的傅里叶级数（1, -0.1616, 0.0083）。
func wave(ph float) float {
	return sin(ph) - 0.1616*sin(2.0*ph) + 0.0083*sin(3.0*ph)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	img := image0Size()

	// Cover：按较大的那个比例缩放后居中裁切，与 Go 侧 p.Image(bg, r, ui.Cover) 一致。
	s := max(size.x/img.x, size.y/img.y)
	off := (size - img*s) * 0.5
	uv := (pos - off) / s / img // 图片空间的 0..1 坐标

	if FlowStrength > 0.00001 {
		dir := FlowDir
		if dot(dir, dir) < 0.001 {
			dir = vec2(1.0, 0.0)
		}

		// 三层遮罩，各占一个纹理槽；未绑定的读为透明（权重 0），自动不参与。
		//   image1 = 整片发区：波长最长、最慢、幅度最小 —— 整体轻浮的底
		//   image2 = 下侧一缕：波长更短、更快、幅度略大
		//   image3 = 顶部一缕：另一组频率，相位错开近半个周期
		b0 := image1Sample(uv*image1Size()).r
		b1 := image2Sample(uv*image2Size()).r
		b2 := image3Sample(uv*image3Size()).r

		// 三层方向各偏 ±0.38 弧度（±22°）。若三层同向，累加出来仍是整片
		// 朝一个方向平移，只是快慢不同；偏开之后才有"各飘各的"分层感。
		d1 := vec2(0.929*dir.x-0.369*dir.y, 0.369*dir.x+0.929*dir.y)
		d2 := vec2(0.929*dir.x+0.369*dir.y, -0.369*dir.x+0.929*dir.y)

		w0 := wave(dot(uv, vec2(6.0, 9.0)) + Time*0.72)
		w1 := wave(dot(uv, vec2(-11.0, 15.0)) + Time*1.18 + 1.9)
		w2 := wave(dot(uv, vec2(13.0, -8.0)) + Time*0.95 + 3.7)

		uv = uv + (dir*w0*b0 + d1*w1*b1*1.35 + d2*w2*b2*1.25)*(FlowStrength*Play)
	}

	c := image0Sample(uv * img)

	// 保亮度染色：把原图的明暗重映射到元素色上（类似单色调滤镜）。
	luma := dot(c.rgb, vec3(0.299, 0.587, 0.114))
	tintLuma := max(dot(Tint, vec3(0.299, 0.587, 0.114)), 0.06)
	tinted := Tint * (luma / tintLuma)
	c = vec4(mix(c.rgb, tinted, TintAmount), c.a)

	return c
}
