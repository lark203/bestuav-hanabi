package main

// 壁纸：静态插画 + 人物区域的呼吸起伏与发丝分层飘动。
//
// 硬约束：**建筑、天空完全不动**。这靠 shake-opacity（人物轮廓遮罩）当总闸门
// 实现——它以外的地方根本不产生位移，而不是靠调参"看起来不动"。
//
// 模型取自参考项目 background.cpp 的 shake 分支：
//
//	float mask = shakeOpacity.Sample(uv + delta).r;
//	return lerp(Original(uv), Original(uv + delta), mask);
//
// 注意它混合的是**颜色**（两次采样后按 mask 插值），不是 UV。这样 mask=0 处
// 严格等于原图像的像素，天空连一个量化误差都不会有。
//
// 为什么不用 flow-mask 当主遮罩（上一版的做法）：实测它覆盖 x 31.5~81.6% /
// y 0~42%，是一条横铺在画面上半部的大带子，把天空和建筑一起圈了进去——
// 那正是"建筑、天空在动"的根因。shake-opacity 才是人物本体
// （实测 x 34.2~59.4% / y 22.2~73.7%，一条竖直的人形带，覆盖仅 4.9%）。
//
// 素材语义（全部按像素实测）：
//   - shake-opacity 1920×1080 灰度：人物区域，非零 4.9%，硬边（p50=255）
//   - flow-mask      960×540 灰度：整片发区（会被人物闸门裁到头部/肩）
//   - wave-a        1920×1080 灰度：一缕发丝（x 46.6~59.2% / y 26.5~42.7%，在人物内）
//   - wave-b        1920×1080 灰度：另一缕，但 bbox y 0~20.3% 落在人物之上
//     （天空/建筑区），被闸门裁掉后几乎不剩，故本主题不启用
//   - flow-rg       1920×1080 RGB：95% 像素为中性色，不适合当方向场（详见 flow 注释）
//   - flow-phase    1920×1080 灰度：实测全 255，无信息量

var Time float // 秒，动效时钟
var Play float // 0..1，动效强度；0 = 完全静止（截图对比与低功耗场景用）

var Tint vec3        // 目标色调（元素色，0..1）
var TintAmount float // 0 = 原色，1 = 完全染色

// BreathStrength 是呼吸起伏的幅度，单位是图片 UV 的垂直分量
// （0.0022 ≈ 4K 图上 4.8px）。0 = 不呼吸。
//
// 只走垂直方向且全人物同步：呼吸时胸腔是整体上下起伏的，不是各部位乱飘。
// 周期由下面的 sin(Time*1.4) 决定，约 4.5 秒一次，对应静息呼吸频率。
var BreathStrength float

// FlowStrength 是发丝飘动的幅度（图片 UV）。0 = 发丝不动。
var FlowStrength float

// wave 是三阶正弦的谐波求和。
//
// 纯正弦走起来像机械抖动；叠上高次谐波才有"快慢不一"的自然感。
// 系数取自参考项目里的傅里叶级数（1, -0.1616, 0.0083）。
func wave(ph float) float {
	return sin(ph) - 0.1616*sin(2.0*ph) + 0.0083*sin(3.0*ph)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	img := image0Size()

	// Cover：按较大的那个比例缩放后居中裁切，与 Go 侧 p.Image(bg, r, ui.Cover) 一致。
	s := max(size.x/img.x, size.y/img.y)
	off := (size - img*s) * 0.5
	uv := (pos - off) / s / img // 图片空间的 0..1 坐标

	c := image0Sample(uv * img)

	if Play > 0.0001 && (BreathStrength > 0.000001 || FlowStrength > 0.000001) {
		// image1 是人物区域：闸门。它以外不产生任何位移。
		person := image1Sample(uv*image1Size()).r
		if person > 0.002 {
			// 呼吸：垂直、全人物同步、约 4.5 秒一个周期。
			delta := vec2(0.0, sin(Time*1.4)*BreathStrength)

			if FlowStrength > 0.000001 {
				// 发丝两层：基础层（整片发区）慢而小，细缕快而略大，方向偏开约 30°。
				// 两层频率、速度、相位都不同，相邻发缕的位移量因此不同，
				// 才是一缕一缕分开飘，而不是整片一起平移。
				b0 := image2Sample(uv*image2Size()).r
				b1 := image3Sample(uv*image3Size()).r
				w0 := wave(dot(uv, vec2(9.0, 13.0)) + Time*0.78)
				w1 := wave(dot(uv, vec2(-12.0, 16.0)) + Time*1.12 + 1.9)
				delta = delta + (vec2(0.87, -0.50)*w0*b0 + vec2(0.99, 0.14)*w1*b1*1.3)*FlowStrength
			}

			// 混合颜色而不是 UV：person=0 处严格等于原图，天空不会有任何变化。
			c = mix(c, image0Sample((uv+delta)*img), person)
		}
	}

	// 保亮度染色：把原图的明暗重映射到元素色上（类似单色调滤镜）。
	luma := dot(c.rgb, vec3(0.299, 0.587, 0.114))
	tintLuma := max(dot(Tint, vec3(0.299, 0.587, 0.114)), 0.06)
	tinted := Tint * (luma / tintLuma)
	c = vec4(mix(c.rgb, tinted, TintAmount), c.a)

	return c
}
