package main

// 壁纸：一张静态插画，靠随时间缓慢漂移的 UV 把它"吹活"，并按主题染色。
//
// 原项目用 flow-rg 方向场 + wave/phase 三张图驱动，这里先用两层不同频率、
// 不同相位的正弦叠加——视觉上同样是"低频、连续、无重复感"的流动，
// 但省掉三张 1920×1080 的采样，CPU 渲染器也能实时跑。
//
// 甘雨等带 Overlay 的主题会再叠一层装饰图（孔明灯 / 清心花纹）：该层相对背景
// 做更轻、不同相位的反向漂动，像灯笼在夜色里摇曳——而不是和背景一起平移。
// OverlayStrength = 0（或 image1 未绑定，mygo 读为透明）时整段不生效，
// 其余主题（不传 overlay）完全不受影响。
//
// 可见性：之前漂移幅度只有 UV 的 0.2%~0.5%、周期约 39 秒，肉眼几乎无感。
// 现在放大到约 0.8%~2.2%、周期约 20~26 秒；为避免 Cover 同比例时位移露黑边，
// 采样先做 8% 的 overscan（内缩四周各留余量）。

var Time float // 秒，动效时钟
var Play float // 0..1，动效强度；0 = 完全静止（截图对比与低功耗场景用）

var Tint vec3        // 目标色调（元素色，0..1）
var TintAmount float // 0 = 原色，1 = 完全染色

var OverlayStrength float // 0 = 不叠加装饰层；>0 时 image1（颜色）/image2（遮罩）参与合成

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	img := image0Size()

	// Cover：按较大的那个比例缩放后居中裁切，与 Go 侧 p.Image(bg, r, ui.Cover) 一致。
	s := max(size.x/img.x, size.y/img.y)
	off := (size - img*s) * 0.5
	uv := (pos - off) / s / img // 图片空间的 0..1 坐标

	// 采样内缩（zoom<1）给漂移留边缘余量：把 [0,1] 映射到 [0.04,0.96]，
	// 四周各留 ~4% 余量，漂移幅度不超过余量就不会顶到图像边缘
	//（Cover 在壁纸与窗口等比例时本无余量，直接位移会露采样黑边）。
	zoom := 0.92
	uv = (uv-0.5)*zoom + 0.5

	// 两条低频波：一条横着走、一条斜着走，周期与相位都不同，叠加后不成规律。
	w1 := sin(uv.x*4.0 + uv.y*1.5 + Time*0.32)
	w2 := sin(uv.y*6.0 - uv.x*2.0 - Time*0.24)

	// 近景（uv.y 大）漂得多，远景几乎不动。幅度显著放大到约 0.8%~2.2%，
	// 周期约 20~26 秒——缓慢但肉眼可辨的流动。
	amp := (0.008 + 0.014*uv.y) * Play
	uv = uv + vec2(w1, w2)*amp

	c := image0Sample(uv * img)

	// 保亮度染色：把原图的明暗重映射到元素色上（类似单色调滤镜）。
	luma := dot(c.rgb, vec3(0.299, 0.587, 0.114))
	tintLuma := max(dot(Tint, vec3(0.299, 0.587, 0.114)), 0.06)
	tinted := Tint * (luma / tintLuma)
	c = vec4(mix(c.rgb, tinted, TintAmount), c.a)

	// 甘雨等主题的装饰叠层：孔明灯 / 清心花纹。相对背景做更轻、不同相位的反向漂动，
	// 制造层间错位的呼吸感；遮罩（image2）决定哪里透出、哪里不显。
	if OverlayStrength > 0.001 {
		oimg := image1Size()
		os := max(size.x/oimg.x, size.y/oimg.y)
		ooff := (size - oimg*os) * 0.5
		ouv := (pos - ooff) / os / oimg
		ouv = (ouv-0.5)*zoom + 0.5

		// 与背景不同的频率与相位、幅度更小且速度更慢——层与层错位摇曳而不是整体平移。
		ow := sin(ouv.x*3.0 - ouv.y*2.0 + Time*0.20)
		oamp := (0.006 + 0.010*ouv.y) * Play
		ouv = ouv + vec2(ow, ow*0.6) * oamp

		oc := image1Sample(ouv * oimg)
		// image2 是透明度遮罩（红通道）：未绑定时 mygo 读为透明，ma = 0，叠层自动不显。
		ma := image2Sample(ouv * oimg).r
		a := ma * OverlayStrength
		c = vec4(mix(c.rgb, oc.rgb, a), c.a)
	}

	return c
}
